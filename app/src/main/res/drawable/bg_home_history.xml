<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#181528"
                android:startColor="#251F3D"
                android:type="linear" />
            <corners android:radius="@dimen/_16sdp" />
            <stroke
                android:width="1.5dp"
                android:color="#A855F7" />
        </shape>
    </item>

    <!-- Normal State -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D9181524"
                android:startColor="#E627233D"
                android:type="linear" />
            <corners android:radius="@dimen/_16sdp" />
            <stroke
                android:width="1dp"
                android:color="#4DA855F7" />
        </shape>
    </item>
</selector>
