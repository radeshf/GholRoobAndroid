<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State (تیره‌تر و فرورفته) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D97706"
                android:startColor="#B45309"
                android:type="linear" />
            <corners android:radius="@dimen/_22sdp" />
            <stroke
                android:width="2dp"
                android:color="#FEF08A" />
        </shape>
    </item>

    <!-- Normal State (گرادینت طلایی-نارنجی زنده) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D97706"
                android:startColor="#FBBF24"
                android:type="linear" />
            <corners android:radius="@dimen/_22sdp" />
            <stroke
                android:width="1.5dp"
                android:color="#FEF08A" />
        </shape>
    </item>
</selector>
