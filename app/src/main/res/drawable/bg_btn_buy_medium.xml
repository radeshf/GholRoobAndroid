<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#A78BFA">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_8sdp" />
                    <solid android:color="#4C1D95" />
                    <stroke
                        android:width="1dp"
                        android:color="#A78BFA" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_8sdp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#2E1065"
                        android:startColor="#3B0764" />
                    <stroke
                        android:width="1dp"
                        android:color="#7C3AED" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
