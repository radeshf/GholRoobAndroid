<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- سایه عمیق زیر کادر -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#0D1117" />
        </shape>
    </item>

    <!-- بدنه اصلی بنر -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#261A1D"
                android:centerColor="#1B1F27"
                android:endColor="#14171F" />
            <!-- حاشیه مینیمال با ته‌رنگ خطری/قرمز -->
            <stroke
                android:width="1dp"
                android:color="#4DFF4D4D" />
        </shape>
    </item>
</layer-list>
