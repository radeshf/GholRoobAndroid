<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- استروک بیرونی کارت طبق پالت game_card_tier_stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#3A445C" />
        </shape>
    </item>

    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14.5dp" />
            <gradient
                android:angle="270"
                android:startColor="#2D3547"
                android:centerColor="#262D3D"
                android:endColor="#1E2330"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
