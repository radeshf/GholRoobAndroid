<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- حالت فشرده شده (Pressed) -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="@dimen/_2sdp">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_8sdp" />
                    <solid android:color="#059669" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- حالت پیش‌فرض (Normal) -->
    <item>
        <layer-list>
            <!-- سایه زیرین -->
            <item android:top="@dimen/_2sdp">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_8sdp" />
                    <solid android:color="#047857" />
                </shape>
            </item>
            <!-- رویه دکمه -->
            <item android:bottom="@dimen/_2sdp">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_8sdp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#10B981"
                        android:endColor="#059669" />
                    <stroke
                        android:width="1dp"
                        android:color="#34D399" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
