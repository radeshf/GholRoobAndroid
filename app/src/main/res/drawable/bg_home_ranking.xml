<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- حالت کلیک / فشرده -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#451A03"
                android:endColor="#78350F"
                android:type="linear" />
            <corners android:radius="@dimen/_18sdp" />
            <stroke
                android:width="2dp"
                android:color="#FDE047" />
        </shape>
    </item>

    <!-- حالت عادی (گرادینت عمیق شیشه‌ای طلایی با بوردر براق) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#2A1B0E"
                android:centerColor="#332415"
                android:endColor="#1E1712"
                android:type="linear" />
            <corners android:radius="@dimen/_18sdp" />
            <stroke
                android:width="1.5dp"
                android:color="#EAB308" />
        </shape>
    </item>
</selector>
