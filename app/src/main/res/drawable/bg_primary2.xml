<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- gradient سبز تیره -->
    <gradient
        android:startColor="#1E5A57"
        android:centerColor="#184A47"
        android:endColor="#0F2F2D"
        android:angle="270"/>

    <!-- حاشیه طلایی -->
    <stroke
        android:width="1dp"
        android:color="@color/golden_border_color"/>

    <!-- گوشه‌های گرد -->
    <corners android:radius="12dp"/>

</shape>
