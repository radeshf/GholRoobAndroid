<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ۱. سایه زیرین (Depth) -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#0D1117" />
        </shape>
    </item>

    <!-- ۲. بدنه اصلی (Surface) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <!-- گرادیانت تیره با مرکز روشن‌تر برای حس عمق -->
            <gradient
                android:angle="270"
                android:startColor="#2D2D30"
                android:centerColor="#1E1E21"
                android:endColor="#121214" />

            <!-- ۳. استروک (Stroke) -->
            <!-- استفاده از عرض 1.5dp برای اینکه کمی ضخیم‌تر از بنر هدف باشد و حس "فعال بودن" بدهد -->
            <stroke
                android:width="1.5dp"
                android:color="#40FFFFFF" /> <!-- سفید نیمه‌شفاف برای هایلایت شدن -->
        </shape>
    </item>

    <!-- ۴. افکت درخشش ملایم داخلی (اختیاری ولی توصیه می‌شود) -->
    <item android:bottom="2dp" android:top="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <stroke
                android:width="0.5dp"
                android:color="#20FFFFFF" />
        </shape>
    </item>
</layer-list>
