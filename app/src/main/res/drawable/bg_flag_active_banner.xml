<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- سایه عمیق زیر کادر -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#0D1117" />
        </shape>
    </item>

    <!-- بدنه اصلی -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#2D2316"
                android:centerColor="#1E1A17"
                android:endColor="#141416" />
            <!-- حاشیه با رنگ کهربایی ملایم -->
            <stroke
                android:width="1dp"
                android:color="#66D69E2E" />
        </shape>
    </item>
</layer-list>
