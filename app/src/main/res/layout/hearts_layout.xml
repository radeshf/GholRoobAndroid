<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/_6sdp"
    android:paddingVertical="@dimen/_5sdp"
    android:paddingHorizontal="@dimen/_5sdp"
    android:background="@drawable/bg_primary2"
    xmlns:android="http://schemas.android.com/apk/res/android">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvHeartCount"
        android:text="1"
        android:visibility="gone"
        android:textSize="@dimen/textLarge"
        android:textColor="@color/white"
        />
    <ImageView
        android:layout_width="@dimen/heart_size"
        android:layout_height="@dimen/heart_size"
        android:id="@+id/ivHeart1"
        android:layout_marginStart="@dimen/_4sdp"
        android:visibility="visible"
        android:contentDescription="@string/contentDescription"
        android:background="@drawable/touch_effect"
        android:src="@drawable/ig_energy"
        />
    <ImageView
        android:layout_width="@dimen/heart_size"
        android:layout_height="@dimen/heart_size"
        android:id="@+id/ivHeart2"

        android:contentDescription="@string/contentDescription"
        android:layout_marginStart="@dimen/_4sdp"
        android:visibility="visible"
        android:background="@drawable/touch_effect"
        android:src="@drawable/ig_energy"
        />
    <ImageView
        android:layout_width="@dimen/heart_size"
        android:layout_height="@dimen/heart_size"
        android:id="@+id/ivHeart3"
        android:layout_marginStart="@dimen/_4sdp"
        android:contentDescription="@string/contentDescription"
        android:visibility="visible"

        android:src="@drawable/ig_energy"
        />
    <ImageView
        android:layout_width="@dimen/heart_size"
        android:layout_height="@dimen/heart_size"
        android:id="@+id/ivHeart4"
        android:layout_marginStart="@dimen/_4sdp"
        android:contentDescription="@string/contentDescription"
        android:visibility="gone"

        android:src="@drawable/ig_energy"
        />
    <ImageView
        android:layout_width="@dimen/heart_size"
        android:layout_height="@dimen/heart_size"
        android:id="@+id/ivHeart5"
        android:layout_marginStart="@dimen/_4sdp"
        android:contentDescription="@string/contentDescription"
        android:visibility="gone"

        android:src="@drawable/ig_energy"
        />

    <ImageButton
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:id="@+id/ivHeartAdd"
        android:layout_marginStart="@dimen/_4sdp"
        android:visibility="visible"
        android:background="@drawable/touch_effect"
        android:scaleType="fitXY"
        android:src="@drawable/ig_add"

        />
</LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvHeartTimer"
            android:visibility="gone"
            android:text=""
            android:textSize="@dimen/textExtraLarge"
            android:textColor="@color/white"
            />
    </LinearLayout>

</LinearLayout>
