<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnrMain"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">


    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar" />

    <LinearLayout
        android:id="@+id/lnrCells"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/lnrBottomViews"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <TextView
            android:id="@+id/tvTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:paddingHorizontal="@dimen/_5sdp"
            android:text="@string/tutorial_msg_3"
            android:textColor="@color/white"
            android:textSize="@dimen/textNormal" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/lnrBottomViews"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvArrows"
                android:gravity="center"
                android:text="مجموع آسیب اطراف"
                android:textColor="@color/white"
                app:layout_constraintBottom_toTopOf="@id/lnrArrows"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"

                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/lnrArrows"
                android:gravity="center"
                app:layout_constraintBottom_toTopOf="@id/rvTiles"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/tile_size"
                    android:layout_height="@dimen/tile_size"
                    />

                <ImageView
                    android:layout_width="@dimen/tile_size"
                    android:layout_height="@dimen/tile_size"
                    />

                <ImageView
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/ic_curve_arrow"
                    android:visibility="invisible"
                    android:rotationY="180"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="@dimen/tile_size"
                    android:layout_height="@dimen/tile_size"
                    android:gravity="center"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1+3"
                        android:textColor="@color/white"
                        app:layout_constraintBottom_toTopOf="@id/lnrArrows"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"

                        />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    app:tint="@color/white"
                    android:src="@drawable/ic_curve_arrow"/>


                <ImageView
                    android:layout_width="@dimen/tile_size"
                    android:layout_height="@dimen/tile_size"
                    />

                <ImageView
                    android:layout_width="@dimen/tile_size"
                    android:layout_height="@dimen/tile_size"
                    />

            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/play_x_margin"
                android:layout_marginEnd="@dimen/play_x_margin"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="7"
                tools:itemCount="21"
                tools:listitem="@layout/option_item" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@id/rvTiles"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:id="@+id/ivLast"
                    android:src="@drawable/ic_left_arrow"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvTutorialNumber"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_15sdp"
                    tools:text="آموزش 1"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textLarge" />
                <ImageView
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:id="@+id/ivNext"
                    android:src="@drawable/ic_left_arrow"
                    android:rotation="180"
                    app:tint="@color/white" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/lnrBottomViews"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/_20sdp"
        android:gravity="center"
        android:id="@+id/lnrHeartArrows">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="جون شما"
            android:layout_marginBottom="@dimen/_10sdp"
            android:textColor="@color/white"

            />

        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            app:tint="@color/white"
            android:rotationY="0"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_curve_arrow"
            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/lnrBottomViews"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/_20sdp"
        android:gravity="center"
        android:id="@+id/lnrFlagArrows">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="پرچم"
            android:layout_marginBottom="@dimen/_10sdp"
            android:textColor="@color/white"
            />

        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            app:tint="@color/white"
            android:rotationY="0"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_curve_arrow"
            />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/lnrBottomViews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:id="@+id/btnHeart"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/play_btn_size"
            android:layout_marginStart="@dimen/play_x_gap"
            android:layout_marginEnd="@dimen/play_x_gap"
            android:background="@drawable/box_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/btn_x_paddings_small"
            android:paddingEnd="@dimen/btn_x_paddings_small">

            <TextView
                android:id="@+id/tvTotalHearts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/white"
                android:textSize="@dimen/textExtraLarge"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:gravity="center"
                android:text="از"
                android:textColor="@color/white"
                android:textSize="@dimen/textSemiLarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHearts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/white"
                android:textSize="@dimen/textExtraLarge"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:contentDescription="@string/contentDescription"
                android:scaleType="fitCenter"
                android:src="@drawable/ig_heart"
                android:visibility="visible" />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/btnTutorial"
            android:layout_width="@dimen/play_btn_size"
            android:layout_height="@dimen/play_btn_size"
            android:layout_marginStart="@dimen/play_x_gap"
            android:layout_marginEnd="@dimen/play_x_gap"
            android:background="@drawable/box_btn"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:contentDescription="@string/contentDescription"
                android:scaleType="fitCenter"
                android:src="@drawable/ig_hint"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnFlag"
            android:layout_width="@dimen/play_btn_size"
            android:layout_height="@dimen/play_btn_size"
            android:layout_marginStart="@dimen/play_x_gap"
            android:layout_marginEnd="@dimen/play_x_gap"
            android:background="@drawable/box_btn"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:contentDescription="@string/contentDescription"
                android:scaleType="fitCenter"
                android:src="@drawable/ig_flag"
                android:visibility="visible" />
        </LinearLayout>

    </LinearLayout>


    <com.mrprojects.gholrob.view.play.views.DamageOverlayView
        android:id="@+id/damageOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1"
        android:clickable="false"
        android:focusable="false"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.mrprojects.gholrob.view.play.views.HealingOverlayView
        android:id="@+id/healingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1"
        android:clickable="false"
        android:focusable="false"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>

