<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_inventory_item"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <!-- دایره پس‌زمینه آیکون (شیشه‌ای، روشن) -->
    <FrameLayout
        android:id="@+id/iconCircle"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="@dimen/_52sdp"
        android:background="@drawable/bg_inventory_circle_icon"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivStatusIcon"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_gravity="center"
            android:contentDescription="@string/contentDescription"
            android:scaleType="fitCenter"
            tools:src="@drawable/ig_coin" />

    </FrameLayout>

    <!-- عدد بزرگ درشت -->
    <TextView
        android:id="@+id/tvStatusCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/textExtraLarge"
        android:textStyle="bold"
        tools:text="12500" />

    <!-- لیبل زیری -->
    <TextView
        android:id="@+id/tvStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:gravity="center"
        android:textColor="@color/textColorOnDark"
        android:textSize="@dimen/textSmall"
        tools:text="سکه" />

</LinearLayout>
