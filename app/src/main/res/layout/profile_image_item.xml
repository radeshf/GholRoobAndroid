<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lnrCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/box_btn"
    android:layout_marginEnd="@dimen/_5sdp"
    android:layout_marginStart="@dimen/_5sdp"
    android:layout_marginTop="@dimen/_4sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    android:padding="@dimen/_4sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        >
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_55sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_marginBottom="@dimen/_1sdp"
            android:contentDescription="@string/contentDescription"
            android:src="@drawable/ig_profile_simorgh"
            tools:layout_constraintBottom_toBottomOf="parent"
            tools:layout_constraintEnd_toEndOf="parent"
            tools:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvName"
            tools:text="نام پروفایل"
            android:textColor="@color/white"
            android:textSize="@dimen/textSmall"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/lnrPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_profile_buy"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible"
            android:padding="@dimen/_4sdp">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_4sdp"
                android:textColor="@color/coin_color"
                android:textSize="@dimen/textSmall"
                android:visibility="visible"
                tools:text="رایگان" />

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:id="@+id/ivPrice"
                android:src="@drawable/ig_coin"
                android:visibility="visible"/>
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:id="@+id/lnrComingSoon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#88000000">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="به زودی"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="@dimen/textLarge"
            android:rotation="-25"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>