<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/_16sdp">

    <!-- بدنه اصلی کارت دیالوگ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDialogBody"
        style="@style/Widget.Game.Dialog.Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/lnrDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_54sdp"
            android:paddingBottom="@dimen/_16sdp">

            <!-- عنوان دیالوگ -->
            <TextView
                android:id="@+id/tvTitleDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اکانت"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold" />

            <!-- کارت بخش ذخیره اکانت -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardBackgroundColor="#1A1D24"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:strokeColor="#2E333D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/lnrAddNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ذخیره اکانت"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:gravity="start"
                        android:lineSpacingExtra="@dimen/_1sdp"
                        android:text="برای حفظ پیشرفت بازی، شماره موبایل خود را متصل کنید. با این کار، در صورت تعویض گوشی یا حذف بازی، حساب شما همیشه امن می‌ماند."
                        android:textColor="#9CA3AF"
                        android:textSize="@dimen/textSemiSmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivCreate"
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:layout_marginHorizontal="@dimen/_1sdp"
                            android:contentDescription="@string/contentDescription"
                            android:src="@drawable/ig_ok"
                            android:visibility="gone" />

                        <!-- دکمه ذخیره اکانت -->
                        <LinearLayout
                            android:id="@+id/btnCreateAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/box_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_8sdp"
                            android:paddingVertical="@dimen/_4sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ذخیره اکانت"
                                android:textColor="@color/dialog_text_color"
                                android:textSize="@dimen/textSmall" />

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:layout_marginHorizontal="@dimen/_5sdp"
                                android:contentDescription="@string/contentDescription"
                                android:padding="@dimen/_3sdp"
                                android:src="@drawable/ig_edit" />

                        </LinearLayout>

                        <!-- فیلد ورودی شماره موبایل -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/DarkTextInputStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:layout_weight="1"
                            android:hint="شماره موبایل">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCreate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:padding="@dimen/_8sdp"
                                android:textColor="@color/white"
                                android:textColorHint="@color/white"
                                android:textSize="@dimen/textNormal" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- جداکننده بخش‌ها -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/_10sdp"
                android:background="#2E333D" />

            <!-- کارت بخش بازیابی اکانت -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1D24"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:strokeColor="#2E333D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/LnrRestore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بازیابی اکانت"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:gravity="start"
                        android:lineSpacingExtra="@dimen/_1sdp"
                        android:text="اگر قبلاً در این بازی ثبت‌نام کرده‌اید، شماره خود را وارد کنید تا به اکانت قبلی‌تان برگردید."
                        android:textColor="#9CA3AF"
                        android:textSize="@dimen/textSemiSmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- دکمه بازیابی اکانت -->
                        <LinearLayout
                            android:id="@+id/btnRestoreAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/box_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_8sdp"
                            android:paddingVertical="@dimen/_4sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="بازیابی اکانت"
                                android:textColor="@color/dialog_text_color"
                                android:textSize="@dimen/textSmall" />

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:layout_marginHorizontal="@dimen/_5sdp"
                                android:contentDescription="@string/contentDescription"
                                android:padding="@dimen/_3sdp"
                                android:src="@drawable/ig_edit" />

                        </LinearLayout>

                        <!-- فیلد ورودی شماره موبایل بازیابی -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/DarkTextInputStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:layout_weight="1"
                            android:hint="شماره موبایل">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRestore"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:padding="@dimen/_8sdp"
                                android:textColor="@color/white"
                                android:textColorHint="@color/white"
                                android:textSize="@dimen/textNormal" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- بخش دکمه بازگشت / بستن -->
            <LinearLayout
                android:id="@+id/lnrBackButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:gravity="center"
                android:orientation="vertical">

                <include
                    android:id="@+id/btnDismiss"
                    layout="@layout/dialog_dismiss_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- آواتار شناور بالای دیالوگ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAvatarFrame"
        android:layout_width="@dimen/_96sdp"
        android:layout_height="@dimen/_96sdp"
        app:cardBackgroundColor="#1A1D24"
        app:cardCornerRadius="@dimen/_48sdp"
        app:cardElevation="@dimen/_10sdp"
        app:strokeColor="#F59E0B"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toTopOf="@+id/cardDialogBody"
        app:layout_constraintEnd_toEndOf="@+id/cardDialogBody"
        app:layout_constraintStart_toStartOf="@+id/cardDialogBody"
        app:layout_constraintTop_toTopOf="@+id/cardDialogBody">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/contentDescription"
            android:scaleType="centerCrop"
            android:src="@drawable/ig_profile_unknown" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
