<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/_16sdp">

    <!-- بدنه اصلی کارت دیالوگ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDialogBody"
        style="@style/Widget.Game.Dialog.Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1D24"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardElevation="@dimen/_8sdp"
        app:strokeColor="#2E333D"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lnrDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_54sdp"
            android:paddingBottom="@dimen/_16sdp">

            <!-- عنوان دیالوگ (تنظیمات) -->
            <TextView
                android:id="@+id/tvTitleDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="تنظیمات"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- توضیحات و پیام دیالوگ -->
            <TextView
                android:id="@+id/tvMessageDialog"
                style="@style/Widget.Game.Dialog.Subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:textColor="@color/game_text_primary"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitleDialog"
                tools:text="" />

            <!-- لیست تنظیمات -->
            <LinearLayout
                android:id="@+id/lnrSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/lnrBackButtons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMessageDialog">

                <!-- 1. دکمه/کارت صدای موسیقی -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSoundSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#212631"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#2E333D"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dialog_x_padding"
                        android:paddingVertical="@dimen/_10sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivBg"
                                android:layout_width="@dimen/settings_icon_size"
                                android:layout_height="@dimen/settings_icon_size"
                                android:contentDescription="@string/contentDescription"
                                android:src="@drawable/ig_sound_on"
                                android:visibility="visible" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:text="صدای موسیقی"
                                    android:textColor="@color/game_text_primary"
                                    android:textSize="@dimen/textVeryLarge"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/tvBg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_minus7sdp"
                                    android:text="(فعال)"
                                    android:textColor="@color/game_text_primary"
                                    android:textSize="@dimen/textNormal"
                                    android:visibility="visible" />

                            </LinearLayout>

                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatSeekBar
                            android:id="@+id/sbBg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:max="100"
                            android:paddingStart="1dp"
                            android:paddingEnd="1dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/bg_volume"
                            android:thumb="@color/colorAccent"
                            android:visibility="visible" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. دکمه/کارت صدای بازی -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSfxSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#212631"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#2E333D"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dialog_x_padding"
                        android:paddingVertical="@dimen/_10sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivSfx"
                                android:layout_width="@dimen/settings_icon_size"
                                android:layout_height="@dimen/settings_icon_size"
                                android:contentDescription="@string/contentDescription"
                                android:src="@drawable/ig_sound_on"
                                android:visibility="visible" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:text="صدای بازی"
                                    android:textColor="@color/game_text_primary"
                                    android:textSize="@dimen/textVeryLarge"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/tvSfx"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_minus7sdp"
                                    android:text="(فعال)"
                                    android:textColor="@color/game_text_primary"
                                    android:textSize="@dimen/textNormal"
                                    android:visibility="visible" />

                            </LinearLayout>

                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatSeekBar
                            android:id="@+id/sbSfx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:max="100"
                            android:paddingStart="1dp"
                            android:paddingEnd="1dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/bg_volume"
                            android:thumb="@color/colorAccent"
                            android:visibility="visible" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. دکمه/کارت ویبره -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnVibrateSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#212631"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#2E333D"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/dialog_x_padding"
                        android:paddingVertical="@dimen/_12sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivVibrate"
                                android:layout_width="@dimen/settings_icon_size"
                                android:layout_height="@dimen/settings_icon_size"
                                android:contentDescription="@string/contentDescription"
                                android:src="@drawable/ig_vibrate_on"
                                android:visibility="visible" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:text="ویبره"
                                    android:textColor="@color/game_text_primary"
                                    android:textSize="@dimen/textVeryLarge"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/tvVibrate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_minus7sdp"
                                    android:text="(فعال)"
                                    android:textColor="@color/game_text_primary"
                                    android:textSize="@dimen/textNormal"
                                    android:visibility="visible" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- بخش دکمه‌های عملیاتی / انصراف -->
            <LinearLayout
                android:id="@+id/lnrBackButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lnrSettings">

                <!-- دکمه بازگشت / انصراف -->
                <include
                    android:id="@+id/btnDismiss"
                    layout="@layout/dialog_dismiss_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- آیکون شناور تنظیمات بالای دیالوگ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIconFrame"
        android:layout_width="@dimen/_96sdp"
        android:layout_height="@dimen/_96sdp"
        android:layout_marginTop="@dimen/_12sdp"
        app:cardBackgroundColor="#1A1D24"
        app:cardCornerRadius="@dimen/_48sdp"
        app:cardElevation="@dimen/_10sdp"
        app:strokeColor="#F59E0B"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toTopOf="@+id/cardDialogBody"
        app:layout_constraintEnd_toEndOf="@+id/cardDialogBody"
        app:layout_constraintStart_toStartOf="@+id/cardDialogBody"
        app:layout_constraintTop_toTopOf="@+id/cardDialogBody">

        <ImageView
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center"
            android:contentDescription="@string/contentDescription"
            android:scaleType="fitCenter"
            android:src="@drawable/ig_settings" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
