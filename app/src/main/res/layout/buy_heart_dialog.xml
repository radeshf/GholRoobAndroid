<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:gravity="center">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnrDialog"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_400sdp"
        android:paddingTop="@dimen/dialog_y_padding"
        android:paddingBottom="@dimen/dialog_y_padding"
        android:paddingEnd="@dimen/dialog_x_padding"
        android:paddingStart="@dimen/dialog_x_padding"
        android:layout_marginStart="@dimen/dialog_x_margin"
        android:layout_marginEnd="@dimen/dialog_x_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/ig_panel">


        <TextView
            android:id="@+id/tvMessageDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginEnd="@dimen/dialog_text_x_margin"
            android:layout_marginStart="@dimen/dialog_text_x_margin"
            android:text="انرژی ای برات نمونده!"
            android:textColor="@color/dialog_text_color"
            android:textSize="@dimen/textSemiLarge"
            app:layout_constraintBottom_toTopOf="@id/lnrBackButtons"
            app:layout_constraintTop_toTopOf="parent" />



        <LinearLayout
            android:id="@+id/lnrBackButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/btnHeartByAds"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_big_h"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/ig_btn"
                android:gravity="center"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="@dimen/_60sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/heart_size"
                        android:layout_height="@dimen/heart_size"
                        android:contentDescription="@string/contentDescription"
                        
                        android:src="@drawable/ig_ads"
                        android:visibility="visible" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_minus4sdp"
                        android:text="تبلیغ"
                        android:textColor="@color/ads_color"
                        android:textSize="@dimen/textLarge"
                        android:visibility="visible" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="@dimen/heart_size"
                    android:layout_height="@dimen/heart_size"
                    android:contentDescription="@string/contentDescription"
                    android:src="@drawable/ig_energy"
                    android:visibility="visible" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="انرژی زا"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/textLarge"
                    android:visibility="visible" />


            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnFullHeart"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_big_h"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/ig_btn"
                android:gravity="center"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="@dimen/_60sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/heart_size"
                        android:layout_height="@dimen/heart_size"
                        android:contentDescription="@string/contentDescription"
                        
                        android:src="@drawable/ig_coin"
                        android:visibility="visible" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_minus4sdp"
                        android:text="1000 سکه"
                        android:textColor="@color/coin_color"
                        android:textSize="@dimen/textLarge"
                        android:visibility="visible" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="@dimen/heart_size_small"
                    android:layout_height="@dimen/heart_size_small"
                    android:contentDescription="@string/contentDescription"
                    
                    android:src="@drawable/ig_energy"
                    android:visibility="visible" />
                <ImageView
                    android:layout_width="@dimen/heart_size_small"
                    android:layout_height="@dimen/heart_size_small"
                    android:contentDescription="@string/contentDescription"
                    
                    android:src="@drawable/ig_energy"
                    android:visibility="visible" />
                <ImageView
                    android:layout_width="@dimen/heart_size_small"
                    android:layout_height="@dimen/heart_size_small"
                    android:contentDescription="@string/contentDescription"
                    
                    android:src="@drawable/ig_energy"
                    android:visibility="visible" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="اسپرسو"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/textNormal"
                    android:visibility="visible" />


            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnBuyHeart"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_big_h"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/ig_btn"
                android:gravity="center"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="@dimen/_60sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/heart_size"
                        android:layout_height="@dimen/heart_size"
                        android:contentDescription="@string/contentDescription"
                        
                        android:src="@drawable/ig_coin"
                        android:visibility="visible" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_minus4sdp"
                        android:text="3500 سکه"
                        android:textColor="@color/coin_color"
                        android:textSize="@dimen/textLarge"
                        android:visibility="visible" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:contentDescription="@string/contentDescription"
                    
                    android:layout_marginEnd="@dimen/_2sdp"
                    android:src="@drawable/ic_add"
                    android:visibility="visible"
                    app:tint="@color/energy_color" />
                <ImageView
                    android:layout_width="@dimen/heart_size"
                    android:layout_height="@dimen/heart_size"
                    android:contentDescription="@string/contentDescription"
                    
                    android:src="@drawable/ig_energy"
                    android:visibility="visible" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="قهوه ساز"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/textNormal"
                    android:visibility="visible" />


            </LinearLayout>


        <include layout="@layout/btn_dismiss_layout"
            android:id="@+id/lnrDismiss"/>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="@dimen/dialog_header_w"
        android:layout_height="@dimen/_60sdp"
        android:background="@drawable/ig_panel_header"
        app:layout_constraintTop_toTopOf="@+id/lnrDialog"
        app:layout_constraintBottom_toTopOf="@+id/lnrDialog"
        app:layout_constraintEnd_toEndOf="@+id/lnrDialog"
        app:layout_constraintStart_toStartOf="@+id/lnrDialog"
        android:gravity="center">

        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:contentDescription="@string/contentDescription"
            android:src="@drawable/ig_energy"
            android:visibility="visible" />
        <TextView
            android:id="@+id/tvTitleDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:text="افزایش انرژی"
            android:textColor="@color/dialog_text_color"
            android:textSize="@dimen/textExtraLarge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:contentDescription="@string/contentDescription"
            android:src="@drawable/ig_energy"
            android:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>