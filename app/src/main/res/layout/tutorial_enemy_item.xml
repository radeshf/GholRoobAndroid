<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:apps="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnrCell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_4sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    android:background="@drawable/box_btn"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_4sdp">

    <ImageView
        android:id="@+id/ivEnemy"
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_55sdp"
        android:layout_marginTop="@dimen/_1sdp"
        android:layout_marginBottom="@dimen/_1sdp"
        android:contentDescription="@string/contentDescription"
        android:src="@drawable/ig_enemy_arzhang_troll"
        apps:layout_constraintBottom_toBottomOf="parent"
        apps:layout_constraintEnd_toEndOf="parent"
        apps:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/lnrRevealed"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="visible"
        apps:layout_constraintEnd_toEndOf="parent"
        apps:layout_constraintEnd_toStartOf="@id/ivEnemy"
        apps:layout_constraintBottom_toBottomOf="parent"
        apps:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible">


            <TextView
                android:id="@+id/tvEnemyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="رادش"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="@dimen/textLarge"
                android:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:id="@+id/lnrDamage"
            android:gravity="center"

            android:orientation="horizontal"
            android:visibility="visible">

            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_margin="@dimen/_1sdp"
                android:contentDescription="@string/contentDescription"
                android:src="@drawable/ig_damage"
                android:rotation="-30"
                apps:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvEnemyDamage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:gravity="center"
                tools:text="0"
                android:textColor="@color/damage_color"
                android:textSize="@dimen/textLarge"
                android:visibility="visible" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:hint="آسیب: "
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="@dimen/textNormal"
                android:visibility="visible" />

        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/lnrEditProfile"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:gravity="center"
        android:visibility="invisible"
        apps:layout_constraintBottom_toBottomOf="parent"
        apps:layout_constraintStart_toEndOf="@+id/lnrRank"
        apps:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_margin="@dimen/_1sdp"
            android:contentDescription="@string/contentDescription"
            android:src="@drawable/ig_edit"
            apps:layout_constraintEnd_toEndOf="parent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lnrMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_4sdp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="invisible"
        apps:layout_constraintBottom_toBottomOf="parent"
        apps:layout_constraintStart_toEndOf="@+id/lnrRank"
        apps:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorAccent"
            android:layout_marginTop="@dimen/_minus2sdp"
            android:text="100000"
            android:textSize="@dimen/textNormal"
            android:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lnrRank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:background="@drawable/bg_rank"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_6sdp"
        android:paddingTop="@dimen/_2sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingBottom="@dimen/_2sdp"
        android:visibility="visible"
        apps:layout_constraintBottom_toBottomOf="parent"
        apps:layout_constraintStart_toStartOf="parent"
        apps:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvEnemyCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorAccent"
            tools:text="x2"
            android:textSize="@dimen/textVeryLarge"
            android:visibility="visible" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>