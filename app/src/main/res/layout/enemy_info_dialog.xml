<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginHorizontal="@dimen/dialog_x_margin"
    android:gravity="center">



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnrDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dialog_y_padding"
        android:paddingBottom="@dimen/dialog_y_padding"
        android:paddingEnd="@dimen/dialog_x_padding"
        android:paddingStart="@dimen/dialog_x_padding"
        android:layout_marginStart="@dimen/dialog_x_margin"
        android:layout_marginEnd="@dimen/dialog_x_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/ig_panel">


        <LinearLayout
            android:id="@+id/lnrCoin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/panel_padding"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvMessageDialog"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:id="@+id/ivEnemy"
                android:contentDescription="@string/contentDescription"
                android:src="@drawable/ig_enemy_arzhang_troll"
                android:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tvDamage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:paddingStart="@dimen/_5sdp"
                    tools:text="1"
                    android:textColor="@color/red"
                    android:textSize="@dimen/_20sdp"
                    android:visibility="visible" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:paddingStart="@dimen/_5sdp"
                    android:text="آسیب:"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textSmall"
                    android:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:paddingStart="@dimen/_5sdp"
                    tools:text="1"
                    android:textColor="@color/red"
                    android:textSize="@dimen/_20sdp"
                    android:visibility="visible" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:paddingStart="@dimen/_5sdp"
                    android:text="تعداد موجود در بازی: "
                    android:textColor="@color/white"
                    android:textSize="@dimen/textSemiSmall"
                    android:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/lnrRemain"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRemain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:paddingStart="@dimen/_5sdp"
                    tools:text="1"
                    android:textColor="@color/red"
                    android:textSize="@dimen/_20sdp"
                    android:visibility="visible" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:paddingStart="@dimen/_5sdp"
                    android:text="باقیمانده در این بازی: "
                    android:textColor="@color/white"
                    android:textSize="@dimen/textSemiSmall"
                    android:visibility="visible" />
            </LinearLayout>


        </LinearLayout>


        <TextView
            android:id="@+id/tvMessageDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginEnd="@dimen/dialog_text_x_margin"
            android:layout_marginStart="@dimen/dialog_text_x_margin"
            tools:text="توضیحات دشمن"
            android:textColor="@color/dialog_text_color"
            android:textSize="@dimen/textSemiLarge"
            app:layout_constraintTop_toBottomOf="@id/lnrCoin"
            app:layout_constraintBottom_toTopOf="@id/lnrBackButtons"
            />


        <LinearLayout
            android:id="@+id/lnrBackButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginEnd="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvMessageDialog"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include layout="@layout/btn_dismiss_layout"
                android:id="@+id/lnrDismiss"/>

        </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="@dimen/dialog_header_w"
        android:layout_height="@dimen/_60sdp"
        android:background="@drawable/ig_panel_header"
        app:layout_constraintTop_toTopOf="@+id/lnrDialog"
        app:layout_constraintBottom_toTopOf="@+id/lnrDialog"
        app:layout_constraintEnd_toEndOf="@+id/lnrDialog"
        app:layout_constraintStart_toStartOf="@+id/lnrDialog"
        android:paddingHorizontal="@dimen/dialog_x_padding"
        android:gravity="center">

        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:contentDescription="@string/contentDescription"
            android:src="@drawable/ig_kill"
            android:visibility="visible" />
        <TextView
            android:id="@+id/tvTitleDialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:text="ارژنگ دیو"
            android:textColor="@color/dialog_text_color"
            android:textSize="@dimen/textExtraLarge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:contentDescription="@string/contentDescription"
            android:src="@drawable/ig_kill"
            android:visibility="visible" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>